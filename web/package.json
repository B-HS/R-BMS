{
    "name": "rbms-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test",
        "verify": "bun run typecheck && bun run lint && bun run test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "auth:generate": "bunx @better-auth/cli generate --config src/server/lib/auth.ts --output src/server/db/auth-schema.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@tanstack/react-query": "^5.102.8",
        "better-auth": "^1.7.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "lucide-react": "^1.43.0",
        "mysql2": "^3.24.4",
        "next": "16.3.4",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "^7.87.0",
        "server-only": "^0.0.1",
        "shadcn": "^4.21.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.14.0",
        "@tailwindcss/postcss": "^4",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@testing-library/react": "^16.3.3",
        "@types/bun": "^1.4.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.3.4",
        "happy-dom": "^20.14.0",
        "msw": "^2.15.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "packageManager": "bun@1.4.0",
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
