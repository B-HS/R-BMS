    destination: [
        { id: 'select-background', layer: 'background', dst: [{ time: 0, x: 0, y: 0, w: 1280, h: 720 }] },
        { id: 'select-foreground', layer: 'foreground', dst: [{ time: 0, x: 0, y: 0, w: 1280, h: 720 }] },
