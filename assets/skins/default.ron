// rbms skin (RON). 1280x720 (16:9) reference space. Pass with --skin assets/skins/default.ron
// field_x/field_width are fractions of screen width; top_y/judge_y/note_height/bga are pixels.
// Layout: tall playfield center-left, BGA box on the right, key beams rising from the judge line.
(
    field_x: 0.05,
    field_width: 0.28,
    top_y: 28.0,
    judge_y: 672.0,
    note_height: 14.0,
    scratch_left: false,
    lift: 0.0,
    key_color: (235, 235, 235),
    key_color_alt: (70, 130, 230),
    scratch_color: (230, 70, 70),
    mine_color: (70, 220, 120),
    lane_bg: (18, 18, 24),
    lane_bg_alpha: 160,
    judge_line: (200, 40, 40),
    beam_color: (200, 220, 255),
    beam_alpha: 150,
    beam_height_frac: 1.0,
    bg: (0, 0, 0),
    bga: Some((470.0, 104.0, 512.0, 512.0)),
)
