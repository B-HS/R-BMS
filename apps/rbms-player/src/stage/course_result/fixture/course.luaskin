    skin.gaugegraph = { { id = "gauges" } }
    skin.destination = {
        { id = -111, dst = { { x = 0, y = 0, w = 1280, h = 720, r = 20, g = 40, b = 80 } } },
        { id = "gauges", dst = { { x = 140, y = 300, w = 1000, h = 200 } } },
        { id = -111, timer = 1, dst = { { x = 0, y = 656, w = 64, h = 64, r = 0, g = 255, b = 0 } } },
        { id = -111, timer = 2, dst = { { x = 1216, y = 656, w = 64, h = 64, r = 255, g = 0, b = 0 } } },
        { id = -111, timer = 150, dst = { { x = 0, y = 0, w = 64, h = 64, r = 255, g = 255, b = 0 } } },
        { id = -111, timer = 151, dst = { { x = 100, y = 0, w = 64, h = 64, r = 255, g = 0, b = 255 } } },
        { id = -111, timer = 152, dst = { { x = 200, y = 0, w = 64, h = 64, r = 0, g = 255, b = 255 } } },
        {
            id = -111,
            draw = function() return main_state.text(150) == "stage 0" and main_state.text(151) == "stage 1" and main_state.text(152) == "" end,
            dst = { { x = 300, y = 0, w = 64, h = 64, r = 255, g = 128, b = 0 } },
        },
        {
            id = -111,
            draw = function() return main_state.number(74) == 8 end,
